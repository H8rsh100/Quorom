# AWS (sandbox account only - never use prod credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SANDBOX_TAG_KEY=quorom:managed
AWS_SANDBOX_TAG_VALUE=true

# Claude API (reasoning agent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# App
DATABASE_URL=sqlite:///./quorom.db
# mock = seed demo findings without AWS/Claude; live = real calls
QUOROM_MODE=mock
DRY_RUN=true
LOOKBACK_DAYS=7
IDLE_CPU_THRESHOLD_PCT=5.0
OVERSIZE_CPU_PEAK_PCT=20.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
