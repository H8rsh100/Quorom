{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QuoromReadOnlyTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeTags",
        "lambda:ListFunctions",
        "lambda:ListTags",
        "lambda:GetFunction",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUntaggedMutationsPlaceholder",
      "Effect": "Deny",
      "Action": [
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute",
        "lambda:DeleteFunction",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/quorom:managed": "true"
        }
      }
    }
  ]
}
